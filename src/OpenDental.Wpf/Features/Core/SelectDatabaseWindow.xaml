<Window x:Class="Imedisoft.Features.Core.SelectDatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Imedisoft.Features.Core"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance local:SelectDatabaseViewModel}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="Choose Database" Height="300" Width="350">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock
                Text="Database Connection"
                TextAlignment="Center"
                FontWeight="Bold"
                Margin="0 0 0 5" />

            <TextBlock
                TextAlignment="Center"
                TextWrapping="Wrap"
                LineHeight="20"
                Margin="0 0 0 10">
                These values will only be used on this computer.
                <LineBreak />
                They have to be set on each computer
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Server"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0 0 10 5" />

                <TextBox Grid.Row="0" Grid.Column="1"
                         Height="26" VerticalContentAlignment="Center"
                         Margin="0 0 0 5" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox Grid.Row="0" Grid.Column="2"
                         Height="26" VerticalContentAlignment="Center"
                         Margin="5 0 0 5" Text="{Binding Port}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="User ID"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0 0 10 5" />

                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                         Height="26" VerticalContentAlignment="Center"
                         Margin="0 0 0 5" Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Password"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0 0 10 5" />

                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                         Height="26" VerticalContentAlignment="Center"
                         Margin="0 0 0 5" Text="{Binding Password}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Database"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0 0 10 5" />

                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                         Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                         Height="26" VerticalContentAlignment="Center"
                         Margin="0 0 0 5" />
            </Grid>

        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Row="0" Grid.Column="0"
                      Content="Do not show this window on startup"
                      VerticalAlignment="Center"
                      IsChecked="{Binding HideOnStartup}" />

            <Button Grid.Row="0" Grid.Column="1"
                    Content="_OK"
                    HorizontalAlignment="Right"
                    Width="80" Height="25"
                    Command="{Binding ConnectCommand}" />
        </Grid>
    </Grid>
</Window>