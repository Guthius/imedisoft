<UserControl x:Class="OpenDental.Modules.Manage.Views.ManageUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:OpenDental.Modules.Manage.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:ManageUserViewModel}"
             d:DesignHeight="360" d:DesignWidth="800">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Daily" VerticalAlignment="Top" Padding="0 5 0 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Button Content="Send Claims" Width="110" Height="25" Margin="0 0 0 2"
                            Command="{Binding SendClaimsCommand}" />
                    <Button Content="Batch Ins" Width="110" Height="25" Margin="0 0 0 2"
                            Command="{Binding OpenInsurancePaymentsCommand}" />
                    <Button Content="Billing" Width="110" Height="25" Margin="0 0 0 2"
                            Command="{Binding OpenBillingCommand}" />
                    <Button Content="Deposits" Width="110" Height="25" Margin="0 0 0 2"
                            Command="{Binding OpenDepositsCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20 0 0 0">
                    <Button Content="Tasks" Width="110" Height="25" Margin="0 0 0 2"
                            Command="{Binding OpenTasksCommand}" />
                    <Button Content="Backup" Width="110" Height="25" Margin="0 0 0 2"
                            Command="{Binding OpenBackupCommand}" />
                    <Button Content="Accounting" Width="110" Height="25" Margin="0 0 0 2"
                            Command="{Binding OpenAccountingCommand}" />
                    <Button Content="Emails" Width="110" Height="25" Margin="0 0 0 2"
                            Command="{Binding OpenEmailsCommand}" />
                    <Button Content="ERAs" Width="110" Height="25" Margin="0 0 0 2"
                            Command="{Binding OpenErasCommand}" />
                    <Button Content="Import Ins Plans" Width="110" Height="25"
                            Command="{Binding ImportInsurancePlansCommand}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="Time Clock" Margin="50 0 0 0" Padding="0 5 0 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0" Grid.Column="0"
                        Margin="0 0 5 0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="Filter by Name" />

                    <TextBox
                        Grid.Row="0" Grid.Column="1"
                        VerticalContentAlignment="Center"
                        Padding="2" Width="100" Height="22"
                        Text="Search Text" />

                    <DataGrid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 5 0 0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid Grid.Column="1" Margin="10 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button Content="Manage" Height="25" Margin="0 0 0 2" />
                        <Button Content="View Time Card" Height="25" Margin="0 0 0 2" />
                        <Button Content="View Breaks" Height="25" Margin="0 0 0 2" />
                        <Button Content="View Schedule" Height="25" Margin="0 0 0 2" />

                        <TextBlock
                            Text="Server Time"
                            TextAlignment="Center"
                            Margin="0 10 0 0" />

                        <TextBlock
                            Text="12:00:00"
                            TextAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Margin="0 0 0 10" />

                        <Button Content="Clock In" Height="25" Margin="0 0 0 2" />
                        <Button Content="Clock Out For:" Height="25" Margin="0 0 0 2" />
                    </StackPanel>

                    <ListBox Grid.Row="1" />
                </Grid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>