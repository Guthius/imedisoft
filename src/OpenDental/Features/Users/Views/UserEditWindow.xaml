<Window x:Class="OpenDental.Features.Users.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:OpenDental.Features.Users.Views"
        mc:Ignorable="d"
        Title="Security" Height="350" Width="960">

    <Grid Margin="5">
        <TabControl>

            <TabItem Header="Users" Width="100" Height="25">
                <views:UserListView />
            </TabItem>

            <TabItem Header="Groups" Width="100" Height="25">
                <views:UserGroupListView />
            </TabItem>

        </TabControl>
    </Grid>

</Window>