<Window
    x:Class="OpenDental.Features.Users.Views.ChangePasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewModels="clr-namespace:OpenDental.Features.Users.ViewModels"
    mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:ChangePasswordViewModel}"
    Width="420" Height="220"
    Title="Change Password">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="15" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0" Grid.Column="0"
            VerticalAlignment="Center"
            Text="User" TextAlignment="Right"
            Margin="6,3" />

        <TextBox
            Grid.Row="0" Grid.Column="1"
            Height="25" VerticalContentAlignment="Center"
            Padding="2,0"
            Background="{StaticResource {x:Static SystemColors.ControlColorKey}}"
            IsReadOnly="True" Text="Dennis Hummel"
            IsReadOnlyCaretVisible="False" />

        <TextBlock
            Grid.Row="2" Grid.Column="0"
            VerticalAlignment="Center"
            Text="Current Password" TextAlignment="Right"
            Margin="6,3" />

        <PasswordBox
            Grid.Row="2" Grid.Column="1"
            Height="25" VerticalContentAlignment="Center"
            Padding="2 0" Margin="0,4" />

        <TextBlock
            Grid.Row="3" Grid.Column="0"
            VerticalAlignment="Center"
            Text="New Password" TextAlignment="Right"
            Margin="6,3" />

        <PasswordBox
            Grid.Row="3" Grid.Column="1"
            Height="25" VerticalContentAlignment="Center"
            Padding="2,0" Margin="0,4" />

        <CheckBox
            Grid.Row="4" Grid.Column="1"
            Content="Show password" Margin="0,4"
            IsChecked="True" />

        <Button
            Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
            Height="25" Width="80"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Content="_Save"
            Command="{Binding SaveCommand}" />

    </Grid>

</Window>