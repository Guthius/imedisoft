<Window x:Class="OpenDental.Features.Providers.Views.ProviderPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:viewModels="clr-namespace:OpenDental.Features.Providers.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:ProviderPickViewModel}"
        Title="ProviderPickWindow" Height="450" Width="450">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Search" TextAlignment="Right"
                VerticalAlignment="Center"
                Padding="5 0" />

            <TextBox Grid.Column="1" Padding="2" Text="{Binding SearchText}" />

            <CheckBox
                Grid.Column="2"
                Content="Show All"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsChecked="{Binding ShowAll}" />
        </Grid>

        <DataGrid Grid.Row="1" Margin="0 5" ItemsSource="{Binding Providers}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Abbr" Width="80" Binding="{Binding Abbr}" />
                <DataGridTextColumn Header="First Name" Width="*" Binding="{Binding FirstName}" />
                <DataGridTextColumn Header="Last Name" Width="*" Binding="{Binding LastName}" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Width="80" Height="25"
                HorizontalAlignment="Left"
                Content="_None"
                Command="{Binding SelectNoneCommand}" />

            <Button
                Grid.Column="1"
                Width="80" Height="25"
                HorizontalAlignment="Right"
                Content="_Save"
                Command="{Binding CloseCommand}" />
        </Grid>
    </Grid>
</Window>